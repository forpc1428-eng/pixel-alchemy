{
  "name": "ultra-forge-desktop",
  "productName": "Ultra Forge",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app wrapping ../../site. Built by .github/workflows/desktop-app.yml",
  "author": "Your Name",
  "main": "main.js",
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.rmSync('app',{recursive:true,force:true});fs.cpSync('../../site','app',{recursive:true})\"",
    "start": "npm run prepare-web && electron .",
    "dist": "npm run prepare-web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ultraforge.desktop",
    "productName": "Ultra Forge",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "linux": { "target": ["AppImage"], "category": "Utility" }
  }
}
